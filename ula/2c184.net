# ZX81 ULA 2C184, gate-level netlist transcribed from Ferranti drawing LD6532/ULA2C184/1 issue 1 (7/4/81).
# Format: see README.md. Grid squares are row then column, as printed on the drawing's edges.

# ---- power ----
VCC     pin_in   VCC            PN40   @1A
GND     pin_in   GND            PN34   @37A

# ---- data pins D0-D7: 16K pull-up, then an emitter-follower input buffer ----
# The pin node itself (nDn) is also driven by the keyboard and port outputs (open collector, rows 12-19).
pD0     pin_io   nD0            PN32   @3B   pullup=16k
pD1     pin_io   nD1            PN30   @4B   pullup=16k
pD2     pin_io   nD2            PN28   @5B   pullup=16k
pD3     pin_io   nD3            PN26   @6B   pullup=16k
pD4     pin_io   nD4            PN24   @7B   pullup=16k
pD5     pin_io   nD5            PN23   @8B   pullup=16k
pD6     pin_io   nD6            PN21   @9B   pullup=16k
pD7     pin_io   nD7            PN19   @10B  pullup=16k
bD0     buf_ef   D0             nD0    @3N
bD1     buf_ef   D1             nD1    @4N
bD2     buf_ef   D2             nD2    @5N
bD3     buf_ef   D3             nD3    @6N
bD4     buf_ef   D4             nD4    @7N
bD5     buf_ef   D5             nD5    @8N
bD6     buf_ef   D6             nD6    @9N
bD7     buf_ef   D7             nD7    @10N

# ---- other input pins (16K pull-up, emitter-follower buffer) ----
pKB0    pin_in   nKB0           PN33   @12B  pullup=16k
pKB1    pin_in   nKB1           PN31   @13B  pullup=16k
pKB2    pin_in   nKB2           PN29   @14B  pullup=16k
pKB3    pin_in   nKB3           PN27   @15B  pullup=16k
pKB4    pin_in   nKB4           PN25   @16B  pullup=16k
pUSA    pin_in   nUSA           PN22   @17B  pullup=16k
pTAPE   pin_in   nTAPE          PN20   @18B  series=400R clamp=diode-to-GND divider=5k-to-VS
pOSC    osc      OSC            PN35   @21B  ceramic resonator
pMREQ   pin_in   nMREQ          PN9    @23B  pullup=16k
pM1     pin_in   nM1            PN10   @24B  pullup=16k
pA15    pin_in   nA15           PN18   @26B  pullup=16k
pHALT   pin_in   nHALT          PN17   @27B  pullup=16k
pA14    pin_in   nA14           PN11   @29B  pullup=16k
pWR     pin_in   nWR            PN8    @32B  pullup=16k
pIORQ   pin_in   nIORQ          PN7    @34B  pullup=16k
pRD     pin_in   nRD            PN6    @36B  pullup=16k
bKB0    buf_ef   KB0            nKB0   @12F  note=(3VBE)
bKB1    buf_ef   KB1            nKB1   @13F  note=(3VBE)
bKB2    buf_ef   KB2            nKB2   @14F  note=(3VBE)
bKB3    buf_ef   KB3            nKB3   @15F  note=(3VBE)
bKB4    buf_ef   KB4            nKB4   @16F  note=(3VBE)
bUSA    buf_ef   USA            nUSA   @17G
iTAPE   inv      TAPE           nTAPE  @18G  ?buffer drawn with output circle
bMREQ   buf_ef   N.MREQ         nMREQ  @23F
bM1     buf_ef   N.M1           nM1    @24F
bA15    buf_ef   A15            nA15   @26F
bHALT   buf_ef   N.HALT         nHALT  @27F
bA14    buf_ef   A14            nA14   @29F
bWR     buf_ef   N.WR           nWR    @32F
bIORQ   buf_ef   N.IORQ         nIORQ  @34F
bRD     buf_ef   N.RD           nRD    @36F

# ---- output pins ----
# PN14 N.Ø (clock to the Z80, row 2), PN15 N.NMI (row 5, open collector with 5K to VCC), PN16 TV/TAPE (row 10,
# 3-level output from N.SYNC and N.VIDEO), PN36-39 and PN1-2 A3'-A8' (rows 12-17), PN5/4/3 A0'-A2' (rows 21-23),
# PN12 RAM N.CS and PN13 ROM N.CS (rows 30-32, RTL stages "see cct diagram").

# ---- port read and the NOP: open-collector drivers onto the data pins (rows 12-19, columns K-Y) ----
# EN = "not reading the port" (high: the drivers let go), from the R/2 inverter at 20K. FORCE = pull the data low
# (the NOP fed to the Z80 for a character), vertical at column W. Checked: row 12 drives D0 ... row 19 drives D7.
kb0a    nor2     n_12R          KB0 EN        @12R
kb0b    nor2     n_12V          n_12R FORCE   @12V
kb0c    pin_oc   nD0            n_12V         @12Y   drives D0 low when n_12V is low
kb1a    nor2     n_13R          KB1 EN        @13R
kb1b    nor2     n_13V          n_13R FORCE   @13V
kb1c    pin_oc   nD1            n_13V         @13Y
kb2a    nor2     n_14R          KB2 EN        @14R
kb2b    nor2     n_14V          n_14R FORCE   @14V
kb2c    pin_oc   nD2            n_14V         @14Y
kb3a    nor2     n_15R          KB3 EN        @15R
kb3b    nor2     n_15V          n_15R FORCE   @15V
kb3c    pin_oc   nD3            n_15V         @15Y
kb4a    nor2     n_16R          KB4 EN        @16R
kb4b    nor2     n_16V          n_16R FORCE   @16V
kb4c    pin_oc   nD4            n_16V         @16Y
d5a     inv      n_17V          FORCE         @17V   D5 has no input: it reads high (pull-up), and is pulled low for the NOP
d5c     pin_oc   nD5            n_17V         @17Y
usaa    nor2     n_17R          USA EN        @17R
usab    inv      n_18V          n_17R         @18V   D6 is not forced for the NOP (a character byte has D6 low already)
usac    pin_oc   nD6            n_18V         @18Y
tapa    nor2     n_18R          TAPE EN       @18R
tapb    nor2     n_19V          n_18R FORCE   @19V
tapc    pin_oc   nD7            n_19V         @19Y
en      inv      EN             n_20AA        @20U   R/2; input from the port decode (to be traced)

# ---- dot shift register Q1-Q8 (rows 3-10, columns T-AL) ----
# Inverters A-H take D0-D7. Each stage's reset is NOR(~Dn, S/L, D6L): with S/L and D6L low, a 1 in the ROM byte
# clears that stage. Stages shift on the falling edge of SCLK (the clock pins carry a bubble), Q1 shifting in a 1.
iA      inv      nA             D0            @6T
iB      inv      nB             D1            @6V
iC      inv      nC             D2            @6X
iD      inv      nD             D3            @6Z
iE      inv      nE             D4            @6AB
iF      inv      nF             D5            @6AD
iG      inv      nG             D6            @6AF
iH      inv      nH             D7            @6AH
rA      nor3     R1             nA S/L D6L    @8T
rB      nor3     R2             nB S/L D6L    @8V
rC      nor3     R3             nC S/L D6L    @8X
rD      nor3     R4             nD S/L D6L    @8Z
rE      nor3     R5             nE S/L D6L    @8AB
rF      nor3     R6             nF S/L D6L    @8AD
rG      nor3     R7             nG S/L D6L    @8AF
rH      nor3     R8             nH S/L D6L    @8AH
Q1      dff      Q1             VCC ~SCLK R1  @10T  D tied to '1'
Q2      dff      Q2             Q1  ~SCLK R2  @10V
Q3      dff      Q3             Q2  ~SCLK R3  @10X
Q4      dff      Q4             Q3  ~SCLK R4  @10Z
Q5      dff      Q5             Q4  ~SCLK R5  @10AB
Q6      dff      Q6             Q5  ~SCLK R6  @10AD
Q7      dff      Q7             Q6  ~SCLK R7  @10AF
Q8      dff      Q8             Q7  ~SCLK R8  @10AH

# ---- character latch NQ11-NQ18 (rows 13-16, columns U-AK): D-type latches, inverted outputs ----
# Inputs checked: NQ11 D0, NQ12 D1, NQ13 D2, NQ14 D3, NQ15 D4, NQ16 D5. Latch clock LCLK is driven by two R/3
# inverters in parallel (rows 18-19, columns AE and AG) from LCLKn.
lck1    inv      LCLK           LCLKn         @18AE  R/3
lck2    inv      LCLK           LCLKn         @18AG  R/3 (in parallel with lck1)
NQ11    dlatch   NQ11           D0 ~LCLK      @14U   output inverted
NQ12    dlatch   NQ12           D1 ~LCLK      @14X
NQ13    dlatch   NQ13           D2 ~LCLK      @14AA
NQ14    dlatch   NQ14           D3 ~LCLK      @14AD
NQ15    dlatch   NQ15           D4 ~LCLK      @14AG?
NQ16    dlatch   NQ16           D5 ~LCLK      @14AJ?
Q17     dlatch   Q17            n_Q17D ~LCLK  @14AL  true output; D from a horizontal at row 13 (to be traced: D6 or D6L)
NQ18    dlatch   NQ18           D7 ~LCLK      @14AN  D7 = the inverse-video bit (to be confirmed)
i17     inv      n_12AO         Q17           @12AO  R/3
vnor    nor2     n_13AS         n_12AO NQ18   @13AS
Q32     dff      Q32            n_13AS ~SCLK? @13AU  clock from the column AH vertical (to be confirmed)
vor     or2      N.VIDEO?       Q8 Q32        @13AX  (to be confirmed)

# ---- line counter Q21-Q28 (rows 4-6, columns AN-BB): ripple toggle stages, each clocked on the falling edge of
# the previous stage's true output; all reset together by CRES (row 6.5). Inverted outputs marked n.
Q21     tff      Q21 Q21n       ~CCLK CRES    @5AN   clock source to be traced (rows 6-8, columns AL-AN: two inverter pairs)
Q22     tff      Q22 Q22n       ~Q21 CRES     @5AQ
Q23     tff      Q23 Q23n       ~Q22 CRES     @5AS
Q24     tff      Q24 Q24n       ~Q23 CRES     @5AV
Q25     tff      Q25 Q25n       ~Q24 CRES     @5AX
Q26     tff      Q26 Q26n       ~Q25 CRES     @5AZ
Q27     tff      Q27 Q27n       ~Q26 CRES     @5BB
Q28     tff      Q28 Q28n       ~Q27 CRES     @5BD
# count 207 = Q28 Q27 Q24 Q23 Q22 Q21 high, Q26 Q25 low: the 8-input NOR goes high and resets the counter,
# so a line is 207 counts (checked against the known 207 T-state line).
c207    nor8     T207           Q28n Q27n Q26 Q25 Q21n Q22n Q23n Q24n   @8BB
# CRES from T207: path rows 8-10, column BE, to be traced
LS      nor4     LINE-SYNC      Q25n Q26 Q27 Q28   @3BE   high for counts 16-31: 16 counts of horizontal sync

# ---- NMI, sync and clock outputs (rows 2-10, columns BE-BJ) ----
nm1     inv      n_5BG          LINE-SYNC     @5BG
nm2     nor2     n_5BI          n_5BG NMIOFF  @5BI   NMIOFF from the NMI flip-flop (row 7, to be traced)
nm3     inv      n_5BL          n_5BI         @5BL
nm4     pin_oc   N.NMI          n_5BL         @5BN   PN15, 5K pull-up to VCC on chip
fs1     nor2     SYNCn          LINE-SYNC FRAME-SYNC   @8BG
fs2     inv      N.SYNC         SYNCn         @8BJ   R/2
tv      out3     TV/TAPE        N.SYNC N.VIDEO   @10BL   PN16, "3 level output" (circuit not on this drawing)
ck1     inv      n_2BH          CLKSRC        @2BH   R/2; CLKSRC: the long line at row 2 (to be traced to Q19)
ck2     pin_tp   N.PHI          n_2BH         @2BL   PN14, totem-pole output
