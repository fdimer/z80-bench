# ZX81 ULA 2C210, gate-level netlist transcribed from Ferranti drawing LD6679/ULA2C210/1 issue 1 (12/01/82).
# Started from the 2C184 transcription (ula/2c184.net): the two drawings share the grid and most of the logic.
# Every line still has to be checked against the 2C210 drawing; lines checked carry 'ok210'.
# Format: see README.md. Grid squares are row then column, as printed on the drawing's edges.

# ---- power ----
VCC     pin_in   VCC            PN40   @1A  ok210
GND     pin_in   GND            PN34   @37A  ok210

# ---- data pins D0-D7: 16K pull-up, then an emitter-follower input buffer ----
# The pin node itself (nDn) is also driven by the keyboard and port outputs (open collector, rows 12-19).
pD0     pin_io   nD0            PN32   @3B   pullup=16k  ok210
pD1     pin_io   nD1            PN30   @4B   pullup=16k  ok210
pD2     pin_io   nD2            PN28   @5B   pullup=16k  ok210
pD3     pin_io   nD3            PN26   @6B   pullup=16k  ok210
pD4     pin_io   nD4            PN24   @7B   pullup=16k  ok210
pD5     pin_io   nD5            PN23   @8B   pullup=16k  ok210
pD6     pin_io   nD6            PN21   @9B   pullup=16k  ok210
pD7     pin_io   nD7            PN19   @10B  pullup=16k  ok210
bD0     buf_ef   D0             nD0    @3N  ok210
bD1     buf_ef   D1             nD1    @4N  ok210
bD2     buf_ef   D2             nD2    @5N  ok210
bD3     buf_ef   D3             nD3    @6N  ok210
bD4     buf_ef   D4             nD4    @7N  ok210
bD5     buf_ef   D5             nD5    @8N  ok210
bD6     buf_ef   D6             nD6    @9N  ok210
bD7     buf_ef   D7             nD7    @10N  ok210

# ---- other input pins (16K pull-up, emitter-follower buffer) ----
pKB0    pin_in   nKB0           PN33   @12B  pullup=16k  ok210
pKB1    pin_in   nKB1           PN31   @13B  pullup=16k  ok210
pKB2    pin_in   nKB2           PN29   @14B  pullup=16k  ok210
pKB3    pin_in   nKB3           PN27   @15B  pullup=16k  ok210
pKB4    pin_in   nKB4           PN25   @16B  pullup=16k  ok210
pUSA    pin_in   nUSA           PN22   @17B  pullup=16k  ok210
pTAPE   pin_in   nTAPE          PN20   @18B  series=400R clamp=diode-to-GND divider=5k-to-VS  ok210
pOSC    osc      OSC            PN35   @21B  ceramic resonator  ok210
pMREQ   pin_in   nMREQ          PN9    @23B  pullup=16k  ok210
pM1     pin_in   nM1            PN10   @24B  pullup=16k  ok210
pA15    pin_in   nA15           PN18   @26B  pullup=16k  ok210
pHALT   pin_in   nHALT          PN17   @27B  pullup=16k  ok210
pA14    pin_in   nA14           PN11   @29B  pullup=16k  ok210
pWR     pin_in   nWR            PN8    @32B  pullup=16k  ok210
pIORQ   pin_in   nIORQ          PN7    @34B  pullup=16k  ok210
pRD     pin_in   nRD            PN6    @36B  pullup=16k  ok210
bKB0    buf_ef   KB0            nKB0   @12F  note=(3VBE)  ok210
bKB1    buf_ef   KB1            nKB1   @13F  note=(3VBE)  ok210
bKB2    buf_ef   KB2            nKB2   @14F  note=(3VBE)  ok210
bKB3    buf_ef   KB3            nKB3   @15F  note=(3VBE)  ok210
bKB4    buf_ef   KB4            nKB4   @16F  note=(3VBE)  ok210
bUSA    buf_ef   USA            nUSA   @17G  ok210
iTAPE   inv      TAPE           nTAPE  @18G  inverter drawn with output circle  ok210
bMREQ   buf_ef   N.MREQ         nMREQ  @23F  ok210
bM1     buf_ef   N.M1           nM1    @24F  ok210
bA15    buf_ef   A15            nA15   @26F  ok210
bHALT   buf_ef   N.HALT         nHALT  @27F  ok210
bA14    buf_ef   A14            nA14   @29F  ok210
bWR     buf_ef   N.WR           nWR    @32F  ok210
bIORQ   buf_ef   N.IORQ         nIORQ  @34F  ok210
bRD     buf_ef   N.RD           nRD    @36F  ok210

# ---- output pins ----
# PN14 N.Ø (clock to the Z80, row 2), PN15 N.NMI (row 5, open collector with 5K to VCC), PN16 TV/TAPE (row 10,
# 3-level output from N.SYNC and N.VIDEO), PN36-39 and PN1-2 A3'-A8' (rows 12-17), PN5/4/3 A0'-A2' (rows 21-23),
# PN12 RAM N.CS and PN13 ROM N.CS (rows 30-32, RTL stages "see cct diagram").

# ---- port read and the NOP: open-collector drivers onto the data pins (rows 12-19, columns K-Y) ----
# EN = "not reading the port" (high: the drivers let go), from the R/2 inverter at 20K. FORCE = pull the data low
# (the NOP fed to the Z80 for a character), vertical at column W. Checked: row 12 drives D0 ... row 19 drives D7.
kb0a    nor2     n_12R          KB0 EN        @12R  ok210
kb0b    nor2     n_12V          n_12R FORCE   @12V  ok210
kb0c    pin_oc   nD0            n_12V         @12Y   drives D0 low when n_12V is low  ok210
kb1a    nor2     n_13R          KB1 EN        @13R  ok210
kb1b    nor2     n_13V          n_13R FORCE   @13V  ok210
kb1c    pin_oc   nD1            n_13V         @13Y  ok210
kb2a    nor2     n_14R          KB2 EN        @14R  ok210
kb2b    nor2     n_14V          n_14R FORCE   @14V  ok210
kb2c    pin_oc   nD2            n_14V         @14Y  ok210
kb3a    nor2     n_15R          KB3 EN        @15R  ok210
kb3b    nor2     n_15V          n_15R FORCE   @15V  ok210
kb3c    pin_oc   nD3            n_15V         @15Y  ok210
kb4a    nor2     n_16R          KB4 EN        @16R  ok210
kb4b    nor2     n_16V          n_16R FORCE   @16V  ok210
kb4c    pin_oc   nD4            n_16V         @16Y  ok210
d5a     inv      n_17V          FORCE         @17V   D5 has no input: it reads high (pull-up), and is pulled low for the NOP  ok210
d5c     pin_oc   nD5            n_17V         @17Y  ok210
usaa    nor2     n_17R          USA EN        @17R  ok210
usab    inv      n_18V          n_17R         @18V   D6 is not forced for the NOP (a character byte has D6 low already)  ok210
usac    pin_oc   nD6            n_18V         @18Y  ok210
tapa    nor2     n_18R          TAPE EN       @18R  ok210
tapb    nor2     n_19V          n_18R FORCE   @19V  ok210
tapc    pin_oc   nD7            n_19V         @19Y  ok210
en      inv      EN             INFE          @20U   ok210; R/2; INFE comes up column L from the fsr gate's input (row 37.8) to row 20.4

# ---- dot shift register Q1-Q8 (rows 3-10, columns T-AL) ----
# Inverters A-H take D0-D7. Each stage's reset is NOR(~Dn, S/L, D6L): with S/L and D6L low, a 1 in the ROM byte
# clears that stage. Stages shift on the falling edge of SCLK (the clock pins carry a bubble), Q1 shifting in a 1.
iA      inv      nA             D0            @6T  ok210
iB      inv      nB             D1            @6V  ok210
iC      inv      nC             D2            @6X  ok210
iD      inv      nD             D3            @6Z  ok210
iE      inv      nE             D4            @6AB  ok210
iF      inv      nF             D5            @6AD  ok210
iG      inv      nG             D6            @6AF  ok210
iH      inv      nH             D7            @6AH  ok210
rA      nor3     R1             nA S/L D6L    @8T  ok210
rB      nor3     R2             nB S/L D6L    @8V  ok210
rC      nor3     R3             nC S/L D6L    @8X  ok210
rD      nor3     R4             nD S/L D6L    @8Z  ok210
rE      nor3     R5             nE S/L D6L    @8AB  ok210
rF      nor3     R6             nF S/L D6L    @8AD  ok210
rG      nor3     R7             nG S/L D6L    @8AF  ok210
rH      nor3     R8             nH S/L D6L    @8AH  ok210
Q1      dff      Q1             VCC ~SCLK R1  @10T  D tied to '1'  ok210
Q2      dff      Q2             Q1  ~SCLK R2  @10V  ok210
Q3      dff      Q3             Q2  ~SCLK R3  @10X  ok210
Q4      dff      Q4             Q3  ~SCLK R4  @10Z  ok210
Q5      dff      Q5             Q4  ~SCLK R5  @10AB  ok210
Q6      dff      Q6             Q5  ~SCLK R6  @10AD  ok210
Q7      dff      Q7             Q6  ~SCLK R7  @10AF  ok210
Q8      dff      Q8             Q7  ~SCLK R8  @10AH  ok210

# ---- character latch NQ11-NQ18 (rows 13-16, columns U-AK): D-type latches, inverted outputs ----
# Inputs checked: NQ11 D0, NQ12 D1, NQ13 D2, NQ14 D3, NQ15 D4, NQ16 D5. Latch clock LCLK is driven by two R/3
# inverters in parallel (rows 18-19, columns AE and AG) from LCLKn.
lck1    inv      LCLK           LCLKn         @18AE  R/3  ok210
lck2    inv      LCLK           LCLKn         @18AG  R/3 (in parallel with lck1)  ok210
NQ11    dlatch   NQ11           D0 ~LCLK      @14U   output inverted  ok210
NQ12    dlatch   NQ12           D1 ~LCLK      @14X  ok210
NQ13    dlatch   NQ13           D2 ~LCLK      @14AA  ok210
NQ14    dlatch   NQ14           D3 ~LCLK      @14AD  ok210
NQ15    dlatch   NQ15           D4 ~LCLK      @14AG?  ok210
NQ16    dlatch   NQ16           D5 ~LCLK      @14AJ?  ok210
Q17     dlatch   Q17            CHAR ~LCLK    @14AL  ok210; true output; D: the row 13.8 line, down column R to the CHAR line at row 19.4 (so Q17 holds 'this fetch was a character', not D6 itself)
d6l     inv      D6L            Q17           @12AN  ok210; R/3; low after a character fetch; its output also runs up column AN to the shift register's D6L line
NQ18    dlatch   NQ18           D7 ~LCLK      @14AN  ok210; D from the row 11.4 line (D7)
# video (rows 12-15, columns AL-AT), 2C210 as drawn: Q32 holds the inverse-video bit; four NORs make VID = XNOR(Q8, Q32)
q32d    nor2     n_q32d         D6L NQ18      @13AM  ok210
Q32     dff      Q32            n_q32d ~S/L -     @13AP  ok210; clocked by S/L (column AJ): it takes the inverse bit when the byte is loaded; no reset drawn
vx      nor2     VX             Q8 Q32        @13AR  ok210; SV = Q8 (Q8's output runs right to column AM and down)
vy      nor2     VY             Q8 VX         @12AU  ok210
vz      nor2     VZ             VX Q32        @14AU  ok210
vid     nor2     VID            VY VZ         @13AX  ok210; R/2. VID = XNOR(Q8, Q32)

# ---- line counter Q21-Q28 (rows 4-6, columns AN-BB): ripple toggle stages, each clocked on the falling edge of
# the previous stage's true output; all reset together by CRES (row 6.5). Inverted outputs marked n.
Q21     tff      Q21 Q21n       ~CCLK CRES    @5AN   ok210; CCLK: the clock (column AK) delayed by four inverters
Q22     tff      Q22 Q22n       ~Q21 CRES     @5AQ  ok210
Q23     tff      Q23 Q23n       ~Q22 CRES     @5AS  ok210
Q24     tff      Q24 Q24n       ~Q23 CRES     @5AV  ok210
Q25     tff      Q25 Q25n       ~Q24 CRES     @5AX  ok210
Q26     tff      Q26 Q26n       ~Q25 CRES     @5AZ  ok210
Q27     tff      Q27 Q27n       ~Q26 CRES     @5BB  ok210
Q28     tff      Q28 Q28n       ~Q27 CRES     @5BD  ok210
# count 207 = Q28 Q27 Q24 Q23 Q22 Q21 high, Q26 Q25 low: the 8-input NOR goes high and resets the counter,
# so a line is 207 counts (checked against the known 207 T-state line).
c207    nor8     T207           Q28n Q27n Q26 Q25 Q21n Q22n Q23n Q24n   @8BB  ok210
# CRES: see crn (row 11): count 207 or INTACK
LS      nor4     LINE-SYNC      Q25n Q26 Q27 Q28   @3BE   high for counts 16-31: 16 counts of horizontal sync  ok210

# ---- NMI, sync and clock outputs (rows 2-10, columns BE-BJ) ----
nm1     inv      n_5BG          LINE-SYNC     @5BG  ok210
nm2     nor2     n_5BI          n_5BG NMIOFF  @5BI   NMIOFF from the NMI latch (nl2)  ok210
nm3     inv      n_5BL          n_5BI         @5BL  ok210
nm4     pin_oc   N.NMI          n_5BL         @5BN   PN15, 5K pull-up to VCC on chip  ok210
fs1     nor2     SYNCn          LINE-SYNC FRAME-SYNC   @8BG  ok210
fs2     inv      N.SYNC         SYNCn         @8BJ   R/2  ok210
tv      out3     TV/TAPE        N.SYNC N.VIDEO   @10BL   PN16, "3 level output" (circuit not on this drawing)  ok210
ck1     inv      n_2BH          CLKSRC        @2BH   R/2; CLKSRC = Q19, up column AK  ok210
ck2     pin_tp   N.PHI          n_2BH         @2BL   PN14, totem-pole output  ok210; non-inverting, so N.PHI = NOT Q19 and the Z80's CLK (through TR2, an inverter) = Q19: the latch windows then fall after CLK falls in T1 and T2, and FORCE covers the T3 rise when the Z80 takes the NOP

# ---- clock: oscillator, Q19, the counter clock (rows 17-25, columns N-AL) ----
oscb    inv      OSCn           OSC           @21E   inverter after the oscillator cell and a cross-under  ok210
Q19     tff      Q19 Q19n       ~OSCn -       @21R   ok210; R/2 cell; clocked from the oscillator line; no reset drawn; Q19 = 3.25 MHz
# CLKSRC (the line that goes up column AK to row 2 and right to the N.PHI output) is Q19's true output (row 21). ok210
alias   CLKSRC   Q19
cc1     inv      n_cc1          Q19           @9AL   four inverters in series delay Q19 into the counter clock  ok210
cc2     inv      n_cc2          n_cc1         @9AN  ok210
cc3     inv      n_cc3          n_cc2         @8AN  ok210
cc4     inv      CCLK           n_cc3         @8AL  ok210
cr      inv      CRES           CRESn         @11AT  R/3  ok210
crn     nor2     CRESn          T207 INTACK   @11AW  ok210; drawn pointing left; INTACK comes up column AV from row 27.3: the line counter restarts at count 207 and at every interrupt acknowledge

# ---- delay chains (rows 17-24) ----
# Chain A (row 17): R/? inverter output up at 17N, then three NOR2 gates with both inputs tied (inverters).
# Chain B (row 21-22): from Q19n, NOR2 gates with both inputs tied, five or more in series.
# Chain C (row 24): NOR2 gates with both inputs tied, from the row 24 vertical at column R.
# LCLKn = NOR4(chain A out, col W vertical from row 13, the row 18 line from column O, Q19)   @18X   R/3
dA0     inv      DA0            OSCn          @18N   ok210; input from the column N vertical down to the oscillator line (row 21)
sck     inv      SCLK           DA0           @16N   ok210; R/3; output up column N to row 13.5, right, up column W to the shift register clocks (row 11.3): the dots shift at 6.5 MHz
dA1     nor2     DA1            DA0 DA0       @17P  ok210
dA2     nor2     DA2            DA1 DA1       @17S  ok210
dA3     nor2     DA3            DA2 DA2       @17U  ok210
lckn    nor4     LCLKn          DA1 DA3 N.M1 Q19   @18V   ok210; R/3; DA1 via row 16.3; N.M1 via column O and row 18.3
i19     inv      n_i19          CHAR          @19T   ok210; CHAR comes up column O to row 19.4
lk2     nor3     FORCE          LCLKn N.M1 n_i19   @18AE  ok210; R/3, 2C210 only; LK2 on the drawing: high when LCLKn is low in an M1 character fetch; down to row 19.8, left, and up column I as FORCE
dB1     nor2     DB1            Q19n Q19n     @21U  ok210
dB2     nor2     DB2            DB1 DB1       @21X  ok210
dB3     nor2     DB3            DB2 DB2       @21AA  ok210
dB4     nor2     DB4            DB3 DB3       @21AC  ok210
dB5     nor2     DB5            DB4 DB4       @21AE  ok210
dC1     nor2     DC1            N.MREQ N.MREQ @24V  ok210
dC2     nor2     DC2            DC1 DC1       @24AC  ok210
dC3     nor2     DC3            DC2 DC2       @24AE  ok210
d21     nor3     n_22AJ         Q19n DB5 DC3  @22AD  ok210; R/2; Q19n along row 21.7 from Q19 and down column AB
d21b    inv      S/L            n_22AJ        @22AE  ok210; R/3; this is S/L: right along row 22.3, up column AJ to the shift register (and Q32's clock)
aen1    nor2     AENa           D6L M1        @24AI  ok210; D6L from d6l's output via row 13.6, column AJ, row 16.2 and down column AG (it crosses the S/L line at row 22.3 without a dot); M1 via row 28.6 and column AD; AENa also runs left along row 25.9 to Q20's D input. So the ULA drives A0'-A8' from the end of a character's M1 to the next M1
aen2    inv      n_aen2         AENa          @24AM  ok210
aen3    inv      AENin          n_aen2        @24AO  ok210; R/2; up column AU to the address enable (row 18)

# ---- address outputs (rows 12-24, columns BD-BJ) ----
# A3'-A8': the latch's inverted outputs are inverted again and driven through tri-state buffers. The buffers' enables
# (active low) share AEN, made by an RTL inverter with a 1.8K pull-up (row 18) from AENin (the long row 18 line).
aen     inv_rtl  AEN            AENin         @18BC  ok210; RTL, 1.8K pull-up
oa3     inv      n_oa3          NQ11          @12BC  ok210
oa4     inv      n_oa4          NQ12          @13BC  ok210
oa5     inv      n_oa5          NQ13          @14BC  ok210
oa6     inv      n_oa6          NQ14          @15BC  ok210
oa7     inv      n_oa7          NQ15          @16BC  ok210
oa8     inv      n_oa8          NQ16          @17BC  ok210
pa3     pin_ts   A3'            n_oa3 ~AEN    @12BH  PN36  ok210
pa4     pin_ts   A4'            n_oa4 ~AEN    @13BH  PN37  ok210
pa5     pin_ts   A5'            n_oa5 ~AEN    @14BH  PN38  ok210
pa6     pin_ts   A6'            n_oa6 ~AEN    @15BH  PN39  ok210
pa7     pin_ts   A7'            n_oa7 ~AEN    @16BH  PN1  ok210
pa8     pin_ts   A8'            n_oa8 ~AEN    @17BH  PN2  ok210
# row counter Q29, Q30, NQ31 (rows 19-23, columns BB-BD): ripple toggles, reset together by RRES (column BA)
Q29     tff      Q29 Q29n       ~SYNCn FRAME-SYNC  @19BB  ok210; reset: FRAME-SYNC, via column BA; clock: SYNCn (fs1's output), down column BB, so the row counter steps as each sync pulse starts
Q30     tff      Q30 Q30n       ~Q29 FRAME-SYNC     @21BB  ok210
NQ31    tff      - NQ31         ~Q30 FRAME-SYNC     @23BB  only the inverted output is drawn  ok210
oa0     inv      n_oa0          Q29n          @20BE  ok210
oa1     inv      n_oa1          Q30n          @21BE  ok210
oa2     inv      n_oa2          NQ31          @22BE  ok210
pa0     pin_ts   A0'            n_oa0 ~AEN    @20BH  PN5, also read back (below)  ok210
pa1     pin_ts   A1'            n_oa1 ~AEN    @21BH  PN4, also read back  ok210
pa2     pin_ts   A2'            n_oa2 ~AEN    @22BH  PN3  ok210
# A0' and A1' are read back into the chip for the port decode
ba0     buf_ef   A0in           A0'           @25BF  ok210
ba1     buf_ef   A1in           A1'           @26BF  ok210

# ---- character fetch decode (row 26, column J), 2C210 as drawn ----
a15i    inv      A15n           A15           @26H   ok210
hlti    inv      HALTn          N.HALT        @27H   ok210
chr     nor4     CHAR           D6 N.MREQ A15n HALTn   @26J   ok210; R/2; high for a memory read from A15 high with D6 low while not halted; top input is D6, via column M and the row 13.0 line
# ---- memory request logic (rows 23-30, columns Q-X), traced on the 2C210 ----
# N.MREQ runs down column R/S: into chain C (row 24), the two select NORs and Q20's clock. N.M1 turns down column R to
# the inverter at row 26.5, whose output M1 resets Q20 and runs right along row 28.6, up column AD to row 24.4 (aen1).
m1i     inv      M1             N.M1          @26U   ok210
a14i    inv      A14n           A14           @29Q   ok210
romacc  nor2     ROMACC         N.MREQ A14    @27T   ok210; high for a memory cycle with A14 low
ramacc  nor2     RAMACC         N.MREQ A14n   @29T   ok210; high for a memory cycle with A14 high; runs right along row 29 to the RAM select
Q20     dff      Q20            AENa ~N.MREQ M1   @27X   ok210; clocked as MREQ goes low; reset by M1; D is AENa (row 25.9, from aen1): set when the ULA drives the address
romln   nor2     ROMLINE        Q20 ROMACC    @30W   ok210; runs right along row 30 to the ROM select
rmin    inv      RAMSELn        RAMACC        @30AJ  ok210

# ---- I/O decode and vertical sync (rows 30-37, columns E-Z) ----
# N.WR turns up at column H to row 30.6, N.IORQ at column I to row 31.0, N.RD at column J to row 31.4.
iowr    nor2     IOWR           N.WR N.IORQ   @33K   ok210; high for any I/O write: clears vertical sync
intack  nor2     INTACK         N.IORQ N.M1   @35K   ok210; high during the interrupt acknowledge (IORQ and M1 both low); runs right to row 35.4, column AK, and up
fsl     nor3     FRAME-SYNC     NMION IOWR FSL   @33N   ok210; R/2; held off while the NMI is on, cleared by any OUT
fsr     nor2     FSL            FRAME-SYNC INFE  @36N   ok210; cross-coupled with fsl: IN with A0 low starts vertical sync

# ---- 2C210 only: blanking (rows 1-2, columns AU-BB) ----
bl1     inv      n_bl1          Q25           @1AU   ok210
bl2     inv      n_bl2          n_bl1         @1AW   ok210
bl3     inv      Q25nd          n_bl2         @1BA   ok210; Q25 inverted and delayed by three gates
blank   nor4     BLANK          Q25nd Q26 Q27 Q28   @1BD   ok210; LINE-SYNC with its start delayed by the three inverters
vb      nor2     n_vb           BLANK VID     @10BA  ok210; VID from vid (row 13.2, right and up)
vbi     inv      N.VIDEO        n_vb          @10BC  ok210; R/2. The 2C210 blanks the picture during line sync
# ---- differences from the 2C184 seen so far (to be transcribed in full) ----
# 1. Rows 1-2, columns AT-BA: a new chain of three inverters fed from Q25 (vertical at column AU) into a NOR at
#    row 1, column BA; it feeds the LINE-SYNC / NMI area. The 2C184 has nothing here.
# 2. Rows 9-10, columns AZ-BB: N.VIDEO now comes from a NOR2 (one input from the row 13 video NOR, R/2, the other from
#    above) through an R/2 inverter, where the 2C184 goes more directly: the 2C210 gates the picture with a second signal
#    (probably blanking during sync).

# ---- port decode and the NMI on/off latch (rows 33-37, columns AR-AX) ----
# Bus from the left (rows 30.8-32.5): N.WR, N.IORQ, N.RD, INFE (driven from here, runs left), NMION (driven from here,
# runs left). A0in and A1in come down columns AO and AP from the read-back buffers (rows 25-26).
infe    nor3     INFE           N.RD N.IORQ A0in   @34AS  ok210; IN with A0 low: keyboard and tape read, starts vertical sync
outfd   nor3     OUTFD          A1in N.IORQ N.WR   @35AS  ok210; OUT with A1 low: NMI off
outfe   nor3     OUTFE          A0in N.IORQ N.WR   @37AS  ok210; OUT with A0 low: NMI on
nl1     nor2     NMION          OUTFD NMIOFF  @35AW  ok210; cross-coupled
nl2     nor2     NMIOFF         NMION OUTFE   @37AW  ok210; runs right to column BC and up to the NMI gate (nm2)

# ---- memory select outputs (rows 30-32, columns BE-BJ): "see cct diagram" (RTL stages and totem-pole outputs) ----
rmi     inv_rtl  RAMCSi         RAMSELn       @30BF  ok210; RTL
rmo     pin_tpn  RAM.N.CS       RAMCSi        @30BI  ok210; PN12; output stage taken as inverting (pin_tpn): its circuit is on the separate 'cct diagram', and the selects only work this way round
rom     nor2_rtl ROMCSi         ROMLINE RAMCSi   @31BF  ok210; RTL. ROM N.CS = ROMLINE or RAMACC: the ROM is selected for A14 low, or while Q20 is set, unless the RAM is
romo    pin_tpn  ROM.N.CS       ROMCSi        @31BI  ok210; PN13; output stage taken as inverting (pin_tpn): its circuit is on the separate 'cct diagram', and the selects only work this way round
